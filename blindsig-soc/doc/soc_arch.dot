// blindsig-soc architecture diagram (blindsig-hardware.org theme)
// Generate: dot -Tsvg soc_arch.dot -o soc_arch.svg
//           dot -Tpng -Gdpi=140 soc_arch.dot -o soc_arch.png

digraph soc {
    rankdir=TB;
    bgcolor="#0a0a0a";
    fontname="Helvetica";
    node [fontname="Helvetica", fontsize=11, fontcolor="#b8c5d0", shape=plaintext];
    edge [fontname="Helvetica", fontsize=9, color="#3a464e", fontcolor="#6b7a86"];

    // ── Firmware ──
    fw [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2a3540">
            <TR><TD BGCOLOR="#26364e" COLSPAN="2"><FONT COLOR="#ffffff"><B>Firmware</B></FONT></TD></TR>
            <TR><TD>C</TD><TD>fw/test_accel.c</TD></TR>
            <TR><TD>Rust</TD><TD>fw-rust/ (blindsig-fw driver)</TD></TR>
            <TR><TD>Test</TD><TD>10² mod 7 = 2</TD></TR>
        </TABLE>>];

    // ── CPU ──
    cpu [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2a3540">
            <TR><TD BGCOLOR="#3a63b0" COLSPAN="2"><FONT COLOR="#ffffff"><B>PicoRV32 CPU</B></FONT></TD></TR>
            <TR><TD>ISA</TD><TD>rv32i</TD></TR>
            <TR><TD>Clock</TD><TD>100 MHz</TD></TR>
            <TR><TD COLSPAN="2"><FONT COLOR="#5f74a0" POINT-SIZE="8">rtl/picorv32.v</FONT></TD></TR>
        </TABLE>>];

    // ── Address Decoder ──
    bus [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2a3540">
            <TR><TD BGCOLOR="#4a5c73" COLSPAN="2"><FONT COLOR="#ffffff"><B>Address Decoder</B></FONT></TD></TR>
            <TR><TD>Select</TD><TD>mem_addr[31:28]</TD></TR>
            <TR><TD COLSPAN="2"><FONT COLOR="#5f74a0" POINT-SIZE="8">rtl/soc_top.v</FONT></TD></TR>
        </TABLE>>];

    // ── RAM ──
    ram [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2a3540">
            <TR><TD BGCOLOR="#2f8f5a" COLSPAN="2"><FONT COLOR="#ffffff"><B>RAM</B></FONT></TD></TR>
            <TR><TD>Address</TD><TD>0x0000_0000</TD></TR>
            <TR><TD>Size</TD><TD>16 KB</TD></TR>
            <TR><TD>Contents</TD><TD>firmware + data + stack</TD></TR>
        </TABLE>>];

    // ── Sim I/O ──
    simio [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2a3540">
            <TR><TD BGCOLOR="#c8912f" COLSPAN="2"><FONT COLOR="#ffffff"><B>Sim I/O</B></FONT></TD></TR>
            <TR><TD>Address</TD><TD>0x1000_0000</TD></TR>
            <TR><TD>Write byte</TD><TD>print char</TD></TR>
            <TR><TD>Write 0xFF</TD><TD>halt sim</TD></TR>
        </TABLE>>];

    // ── Bus Wrapper ──
    buswrap [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2a3540">
            <TR><TD BGCOLOR="#7e5cbf" COLSPAN="2"><FONT COLOR="#ffffff"><B>Bus Wrapper</B></FONT></TD></TR>
            <TR><TD COLSPAN="2">valid/ready ↔ wen/ren</TD></TR>
            <TR><TD COLSPAN="2"><FONT COLOR="#5f74a0" POINT-SIZE="8">rtl/blindsig_bus_wrap.v</FONT></TD></TR>
        </TABLE>>];

    // ── Accelerator ──
    accel [label=<
        <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#2a3540">
            <TR><TD BGCOLOR="#c14a4a" COLSPAN="2"><FONT COLOR="#ffffff"><B>BlindSig Accelerator</B></FONT></TD></TR>
            <TR><TD>Address</TD><TD>0x2000_0000</TD></TR>
            <TR><TD>CTRL</TD><TD>+0x00 (start/reset/load)</TD></TR>
            <TR><TD>STATUS</TD><TD>+0x04 (busy/done/error)</TD></TR>
            <TR><TD>OPERAND</TD><TD>+0x08</TD></TR>
            <TR><TD>RESULT</TD><TD>+0x0C</TD></TR>
            <TR><TD>MODULUS</TD><TD>+0x10</TD></TR>
            <TR><TD>Operation</TD><TD>op² mod m</TD></TR>
            <TR><TD COLSPAN="2"><FONT COLOR="#5f74a0" POINT-SIZE="8">blindsig-rtl/rtl/blindsig_accel.v</FONT></TD></TR>
        </TABLE>>];

    // ── Dataflow ──
    fw -> cpu [label="  loaded into RAM\n  at synthesis/sim", style=dashed, color="#5f74a0"];

    cpu -> bus [label=<
        <TABLE BORDER="0" CELLSPACING="0" CELLPADDING="2">
            <TR><TD><FONT COLOR="#6b7a86">mem_valid / mem_ready</FONT></TD></TR>
            <TR><TD><FONT COLOR="#6b7a86">mem_addr / mem_wdata</FONT></TD></TR>
            <TR><TD><FONT COLOR="#6b7a86">mem_rdata / mem_wstrb</FONT></TD></TR>
        </TABLE>>, penwidth=2];

    bus -> ram     [label="  0x0___", penwidth=2, color="#2f8f5a"];
    bus -> simio   [label="  0x1___", penwidth=2, color="#c8912f"];
    bus -> buswrap [label="  0x2___", penwidth=2, color="#7e5cbf"];
    buswrap -> accel [penwidth=2, color="#c14a4a"];
}
